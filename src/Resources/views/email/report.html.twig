{#
  Email report of austral:log:report (HTML version).
  Override it in templates/bundles/AustralLogBundle/email/report.html.twig.
  Variables: report (Austral\LogBundle\Report\ErrorReport), subject.
#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ subject }}</title>
</head>
<body style="margin: 0; padding: 24px; background: #f4f5f7; color: #1f2933; font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 760px; margin: 0 auto; background: #ffffff; border-radius: 6px;">
    <tr>
      <td style="padding: 24px;">
        <h1 style="margin: 0 0 8px; font-size: 20px;">{{ subject }}</h1>
        <p style="margin: 0 0 16px; color: #52606d;">
          {% if report.since %}Since {{ report.since|date('Y-m-d H:i') }}{% else %}First report{% endif %}, until {{ report.until|date('Y-m-d H:i') }}:
          {{ report.newCount }} new, {{ report.regressionCount }} {{ report.regressionCount == 1 ? 'regression' : 'regressions' }}{% if report.moreCount > 0 %}, and {{ report.moreCount }} more not listed{% endif %}.
        </p>

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse;">
          <thead>
            <tr>
              <th scope="col" align="left" style="padding: 8px; border-bottom: 2px solid #cbd2d9;">Error</th>
              <th scope="col" align="right" style="padding: 8px; border-bottom: 2px solid #cbd2d9;">Occurrences</th>
              <th scope="col" align="right" style="padding: 8px; border-bottom: 2px solid #cbd2d9;">Last seen</th>
            </tr>
          </thead>
          <tbody>
            {% for row in report.rows %}
              <tr>
                <td style="padding: 8px; border-bottom: 1px solid #e4e7eb; vertical-align: top;">
                  <strong style="color: {{ row.regression ? '#b44d12' : '#ab091e' }};">{{ row.regression ? 'Regression' : 'New' }}</strong>
                  · {{ row.level }} · {{ row.channel }}<br>
                  {% if row.class %}<code style="font-size: 13px;">{{ row.class }}</code><br>{% endif %}
                  {{ row.message|length > 300 ? row.message|slice(0, 300) ~ '…' : row.message }}
                  {% if row.file %}<br><span style="color: #52606d; font-size: 12px;">{{ row.file }}{% if row.line %}:{{ row.line }}{% endif %}</span>{% endif %}
                </td>
                <td align="right" style="padding: 8px; border-bottom: 1px solid #e4e7eb; vertical-align: top;">{{ row.occurrences }}</td>
                <td align="right" style="padding: 8px; border-bottom: 1px solid #e4e7eb; vertical-align: top; white-space: nowrap;">{{ row.lastSeen|date('Y-m-d H:i') }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        {% if report.moreCount > 0 %}
          <p style="margin: 16px 0 0;">{{ report.moreCount }} more {{ report.moreCount == 1 ? 'error is' : 'errors are' }} not listed: see the back office.</p>
        {% endif %}
      </td>
    </tr>
  </table>
  <p style="max-width: 760px; margin: 12px auto 0; color: #7b8794; font-size: 12px; text-align: center;">Sent by austral/log-bundle ({{ report.environment }}).</p>
</body>
</html>
