{
  "name": "austral/log-bundle",
  "type": "symfony-bundle",
  "description": "Austral Log Bundle: errors of the site recorded in the database, grouped by fingerprint, with statuses and an email digest",
  "keywords": [
    "Austral",
    "Log",
    "Error",
    "Monolog"
  ],
  "license": "MIT",
  "homepage": "https://austral.dev",
  "authors": [
    {
      "name": "Matthieu Beurel",
      "email": "matthieu@austral.dev",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.4 <9.0",
    "ext-json": "*",
    "ext-mbstring": "*",
    "austral/contracts": "^4.0",
    "austral/entity-bundle": "^4.0",
    "doctrine/collections": "^2.2 || ^3.1",
    "doctrine/dbal": "^4.0",
    "doctrine/doctrine-bundle": "^3.2.2",
    "doctrine/orm": "^3.7",
    "doctrine/persistence": "^4.0",
    "monolog/monolog": "^3.5",
    "psr/clock": "^1.0",
    "symfony/config": "^7.4",
    "symfony/console": "^7.4",
    "symfony/dependency-injection": "^7.4",
    "symfony/event-dispatcher-contracts": "^3.5",
    "symfony/http-foundation": "^7.4",
    "symfony/http-kernel": "^7.4",
    "symfony/monolog-bundle": "^3.10 || ^4.0",
    "symfony/service-contracts": "^3.5",
    "symfony/uid": "^7.4",
    "symfony/yaml": "^7.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^11.5",
    "symfony/event-dispatcher": "^7.4",
    "symfony/framework-bundle": "^7.4",
    "symfony/security-core": "^7.4"
  },
  "suggest": {
    "symfony/security-core": "To record the id of the logged in user with each occurrence"
  },
  "config": {
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Austral\\LogBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Austral\\LogBundle\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
